# ─── إعدادات السيرفر ───────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── MongoDB ────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/sudacards

# ─── JWT Secret (غيّر هذا لقيمة عشوائية قوية!) ────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_1234567890

# ─── SMTP لإرسال OTP بالبريد ─────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM="SudaCard <noreply@yourdomain.com>"
